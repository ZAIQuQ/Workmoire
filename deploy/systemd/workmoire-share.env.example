# This file must not contain the workspace's credentials or Codex configuration.
WORKSPACE_SHARE_HOST=0.0.0.0
WORKSPACE_SHARE_PORT=5201
WORKSPACE_SHARE_DATA_DIR=/var/lib/workmoire-share
WORKSPACE_SHARE_AUTH_DIR=/var/lib/workmoire-share/auth
WORKSPACE_SHARE_STATIC_DIR=/opt/workmoire-share/workspace/static
# Set the same external origin here and in the owner service when using a proxy.
WORKSPACE_SHARE_PUBLIC_URL=
# Set to 1 behind HTTPS termination.
WORKSPACE_SHARE_COOKIE_SECURE=0
