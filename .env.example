WORKSPACE_HOST=0.0.0.0
WORKSPACE_PORT=5200
WORKSPACE_DATA_DIR=./data
WORKSPACE_SESSION_SECRET=replace-with-a-long-random-secret
# Required before the first account is created when WORKSPACE_HOST is not
# loopback. Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep this value private; an empty value is accepted only for loopback binds.
WORKSPACE_SETUP_TOKEN=
# Optional. Leave empty to keep the local assistant disabled.
WORKSPACE_CODEX_BIN=
# If Codex uses a custom configuration directory, explicitly set CODEX_HOME
# in the private service environment as well; systemd does not inherit a shell.
# Configure HTTP_PROXY/HTTPS_PROXY/NO_PROXY there too if the model provider
# needs the server's trusted egress proxy.
# Optional model override. Leave empty to use the Codex CLI profile.
WORKSPACE_CODEX_MODEL=
# Keep web requests responsive; choose low, medium, high, or xhigh.
WORKSPACE_CODEX_REASONING_EFFORT=low
WORKSPACE_ASSISTANT_TIMEOUT=45

# Optional trusted HTTP CONNECT proxy for public paper metadata/PDF retrieval.
WORKSPACE_PAPER_PROXY=
